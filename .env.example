DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
TZ=America/Mexico_City
# USE_SQLITE=true permite ejecutar pruebas o desarrollo sin PostgreSQL.
USE_SQLITE=false

POSTGRES_DB=goey_smar
POSTGRES_USER=goey_smar
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
DISCOVERY_DISPATCH_INTERVAL_SECONDS=60
DISCOVERY_DISPATCH_BATCH_SIZE=100
DISCOVERY_STAGGER_SECONDS=5
DISCOVERY_TASK_EXPIRES_SECONDS=900
DISCOVERY_NOTIFICATION_EXPIRES_SECONDS=900
DISCOVERY_RETRY_DELAY_SECONDS=30
DISCOVERY_RETENTION_DAYS=90
DISCOVERY_RETENTION_BATCH_SIZE=5000
DISCOVERY_QUEUE=discovery
DISCOVERY_NOTIFICATIONS_QUEUE=discovery_notifications
MONITOR_INTERVAL_SECONDS=40
MONITOR_TASK_TIME_LIMIT_SECONDS=240
MONITOR_RUNNING_STALE_MINUTES=10
MONITOR_FAILURE_ALERT_COOLDOWN_MINUTES=60
MONITOR_INFRASTRUCTURE_FAILURE_RESTART_THRESHOLD=3
MONITOR_AUTO_RESTART_WORKER_ON_INFRA_FAILURE=true
MONITOR_RETENTION_DAYS=7
MONITOR_RETENTION_BATCH_SIZE=1000

AMAZON_SAVED_ITEMS_URL=https://www.amazon.com.mx/gp/cart/view.html
AMAZON_BASE_URL=https://www.amazon.com.mx
AMAZON_ASSOCIATE_TAG=
AMAZON_CREATORS_API_CLIENT_ID=
AMAZON_CREATORS_API_CLIENT_SECRET=
AMAZON_CREATORS_API_CREDENTIAL_VERSION=3
AMAZON_CREATORS_API_MARKETPLACE=www.amazon.com.mx
AMAZON_CREATORS_API_PARTNER_TAG=
AMAZON_CREATORS_API_LANGUAGES=es_MX
AMAZON_CREATORS_API_TIMEOUT_SECONDS=5
AMAZON_SCRAPER_A_INTERVAL_SECONDS=40
AMAZON_SCRAPER_A_COUNTDOWN_SECONDS=0
AMAZON_SCRAPER_B_INTERVAL_SECONDS=40
AMAZON_SCRAPER_B_COUNTDOWN_SECONDS=5
AMAZON_CREATORS_API_INTERVAL_SECONDS=40
AMAZON_CREATORS_API_COUNTDOWN_SECONDS=10
AMAZON_CREATORS_API_TASK_TIME_LIMIT_SECONDS=240
AMAZON_CREATORS_API_BATCH_SIZE=10
AMAZON_CREATORS_API_BATCH_DELAY_SECONDS=1
AMAZON_CREATORS_API_MAX_ATTEMPTS=2
AMAZON_CREATORS_API_RETRY_DELAY_SECONDS=1
ALERT_RESERVATION_SECONDS=90
MANUAL_ALERT_USE_STORED_CONTENT=false
AMAZON_PROFILE_DIR=.amazon-profile
AMAZON_PROFILE_DIR_AMAZON_A=.amazon-profile
AMAZON_PROFILE_DIR_AMAZON_B=.amazon-profile-amazon-b
AMAZON_HEADLESS=true
AMAZON_TIMEOUT_MS=45000
AMAZON_BROWSER_LAUNCH_TIMEOUT_MS=60000
AMAZON_SCRAPER_MAX_ATTEMPTS=2
AMAZON_SCRAPER_RETRY_DELAY_SECONDS=5
MERCADOLIBRE_DISCOVERY_MAX_PAGES=50
MERCADOLIBRE_DISCOVERY_TIMEOUT_SECONDS=20

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ERROR_BOT_TOKEN=
TELEGRAM_ERROR_CHAT_ID=
TELEGRAM_DISCOVERY_BOT_TOKEN=
TELEGRAM_TOP100_CHANNEL_ID=
TELEGRAM_NEWEST_CHANNEL_ID=
TELEGRAM_TRACKERS_CHANNEL_ID=
TELEGRAM_MERCADOLIBRE_CHANNEL_ID=

# Alertas de respaldo por email cuando falla la ejecucion del scraper.
# Para Gmail use una contrasena de aplicacion, no la contrasena normal.
# Primero se intenta TELEGRAM_ERROR_BOT_TOKEN con TELEGRAM_ERROR_CHAT_ID.
# Si Telegram falla y MONITOR_FAILURE_EMAIL_RECIPIENTS esta configurado, se intenta email.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion
DEFAULT_FROM_EMAIL=tu-correo@gmail.com
MONITOR_FAILURE_EMAIL_RECIPIENTS=destino@example.com
MONITOR_FAILURE_EMAIL_SUBJECT_PREFIX=[Goey SMAR]
